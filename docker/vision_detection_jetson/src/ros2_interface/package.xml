<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>ros2_interface</name>
  <version>0.1.0</version>

  <description>
    Shared ROS 2 interfaces used by all containers.
  </description>

  <maintainer email="108789279+nimahmoodi1@users.noreply.github.com">Nima Mahmoudi</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/nimahmoodi1/yolov8-ros2-jetson-tensorrt-detector</url>
  <url type="bugtracker">https://github.com/nimahmoodi1/yolov8-ros2-jetson-tensorrt-detector/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
