<?xml version="1.0"?>
<package format="3">
  <name>vision_feedback</name>
  <version>1.1.0</version>
  <description>
    ROS 2 Humble tower head/body detection node. Runs YOLOv8n through a cached
    TensorRT FP16 engine on Jetson (with a PyTorch fallback) and publishes
    temporally filtered, stabilized bounding boxes.
  </description>

  <maintainer email="108789279+nimahmoodi1@users.noreply.github.com">Nima Mahmoudi</maintainer>
  <license>BSD-3-Clause</license>

  <url type="repository">https://github.com/nimahmoodi1/yolov8-ros2-jetson-tensorrt-detector</url>
  <url type="bugtracker">https://github.com/nimahmoodi1/yolov8-ros2-jetson-tensorrt-detector/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
